{%- if breadcrumbs.count -%}
    {%- set itemListElement = [] -%}
    {%- for breadcrumb in breadcrumbs -%}
        {%- set itemListElement = itemListElement|merge([{
            '@type': 'ListItem',
            'position': loop.index,
            'item': {
                '@id': breadcrumb.url,
                'name': breadcrumb.title|trans,
            },
        }]) -%}
    {%- endfor -%}
    <script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            'itemListElement': itemListElement,
        }|json_encode(
            constant('JSON_HEX_TAG')
            b-or constant('JSON_HEX_AMP')
            b-or constant('JSON_HEX_APOS')
            b-or constant('JSON_HEX_QUOT')
            b-or constant('JSON_UNESCAPED_SLASHES')
        )|raw }}
    </script>
{%- endif -%}
